{
  "name": "verifiable-process-reward-fund",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "check": "tsc --noEmit",
    "check:env": "node --import tsx scripts/check-env.ts",
    "provider:gate": "node --import tsx scripts/provider-gate.ts",
    "agent:onboard": "node --import tsx packages/ens/src/onboard.ts",
    "test:contracts": "forge test --root contracts",
    "fmt:contracts": "forge fmt --root contracts",
    "test:backend": "node --import tsx --test packages/backend/test/*.test.ts",
    "backend": "node --import tsx packages/backend/src/server.ts",
    "dev": "next dev packages/frontend",
    "build:frontend": "next build packages/frontend --webpack",
    "aqua:seed": "node --import tsx scripts/seed-liquidity.ts",
    "swap:manual": "node --import tsx scripts/manual-swap.ts",
    "oracle:build": "cargo build --manifest-path packages/oracle/Cargo.toml --target wasm32-unknown-unknown --release --locked",
    "oracle:test": "cargo test --manifest-path packages/oracle/Cargo.toml --locked",
    "oracle:configure": "node --import tsx scripts/oracle-config.ts",
    "oracle:pack": "node --import tsx scripts/oracle.ts pack",
    "oracle:publish": "node --import tsx scripts/oracle.ts publish",
    "oracle:stream": "node --import tsx scripts/oracle.ts stream",
    "oracle:reproduce": "node --import tsx scripts/reproduce.ts",
    "policy:improve": "node --import tsx scripts/improve.ts",
    "ens:deploy-agent": "node --import tsx packages/ens/src/deploy-tree.ts",
    "price:mark": "node --import tsx scripts/mark-price.ts",
    "subgraph:deploy": "node --import tsx scripts/subgraph-deploy.ts",
    "order:sign": "node --import tsx scripts/sign-order.ts",
    "subgraph:build": "graph build packages/subgraph/subgraph.yaml",
    "ens:setup-root": "node --import tsx scripts/ens-root.ts"
  },
  "devDependencies": {
    "@1inch/aqua-sdk": "^0.3.4",
    "@1inch/solidity-utils": "6.9.10",
    "@1inch/swap-vm-sdk": "^0.4.4",
    "@graphprotocol/graph-cli": "0.98.1",
    "@openzeppelin/contracts": "5.4.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^13.2.0",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "prettier": "3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.22.6",
    "wagmi": "^2.19.5"
  }
}
